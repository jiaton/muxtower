// Cloudflare Workers static assets: `npm run build`, then `npx wrangler deploy`. The hostname is the
// deployment's (set in the dashboard), not this file's.
{
  "name": "muxtower-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Every page is a file: the site is one page, and the demo one more (it routes by the URL's hash).
    // Anything else is a plain 404.
    "not_found_handling": "none",
  },
}
