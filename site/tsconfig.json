{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src", "astro.config.mjs", "vitest.config.ts", "scripts"],
  "exclude": ["dist", "deploy"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": { "@/*": ["./src/*"], "@app/*": ["../app/src/*"] },
    "types": ["vite/client", "node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  }
}
