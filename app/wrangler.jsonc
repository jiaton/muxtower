// Cloudflare Workers static assets. "Deploy to Cloudflare" or `npx wrangler deploy` after `npm run build`.
// Preset daemons: set MUXTOWER_APP_CONFIG as a build variable (see the README), never commit tokens.
{
  "name": "muxtower-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
