{
  "components": {
    "schemas": {
      "AgentState": {
        "enum": [
          "needs_permission",
          "needs_answer",
          "needs_trust",
          "plan_review",
          "error",
          "busy",
          "idle",
          "unknown"
        ],
        "title": "AgentState",
        "type": "string"
      },
      "ApprovalResult": {
        "properties": {
          "option": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Option"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/AgentState"
          }
        },
        "required": [
          "session_id",
          "state",
          "option"
        ],
        "title": "ApprovalResult",
        "type": "object"
      },
      "Approve": {
        "properties": {
          "option": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "option key to pick; default per runtime rules",
            "title": "Option"
          }
        },
        "title": "Approve",
        "type": "object"
      },
      "ClaimRequest": {
        "properties": {
          "code": {
            "maxLength": 32,
            "minLength": 4,
            "title": "Code",
            "type": "string"
          },
          "device_name": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Device Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "device_name"
        ],
        "title": "ClaimRequest",
        "type": "object"
      },
      "ClaimResult": {
        "properties": {
          "daemon_name": {
            "title": "Daemon Name",
            "type": "string"
          },
          "device_name": {
            "title": "Device Name",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "device_name",
          "daemon_name"
        ],
        "title": "ClaimResult",
        "type": "object"
      },
      "CreateSession": {
        "properties": {
          "args": {
            "description": "extra arguments for the agent binary",
            "items": {
              "type": "string"
            },
            "title": "Args",
            "type": "array"
          },
          "cwd": {
            "title": "Cwd",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "runtime": {
            "title": "Runtime",
            "type": "string"
          }
        },
        "required": [
          "runtime",
          "cwd"
        ],
        "title": "CreateSession",
        "type": "object"
      },
      "Device": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current": {
            "description": "the device making this request",
            "title": "Current",
            "type": "boolean"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "created_at",
          "last_used_at",
          "current"
        ],
        "title": "Device",
        "type": "object"
      },
      "ErrorFrame": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ErrorFrame",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "Me": {
        "properties": {
          "daemon_name": {
            "title": "Daemon Name",
            "type": "string"
          },
          "token_name": {
            "title": "Token Name",
            "type": "string"
          }
        },
        "required": [
          "token_name",
          "daemon_name"
        ],
        "title": "Me",
        "type": "object"
      },
      "Option": {
        "description": "One numbered choice in a dialog, e.g. key \"2\", label \"Yes, allow reads during this session\".",
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label"
        ],
        "title": "Option",
        "type": "object"
      },
      "PairCode": {
        "properties": {
          "code": {
            "description": "one-time code, e.g. K7QM-3XPA",
            "title": "Code",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "code",
          "expires_at"
        ],
        "title": "PairCode",
        "type": "object"
      },
      "PendingAction": {
        "description": "What the agent is waiting for. tool_name/detail come from hooks; options from the screen.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "title": "Options",
            "type": "array"
          },
          "recommended": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "option key approve picks when none is given",
            "title": "Recommended"
          },
          "state": {
            "$ref": "#/components/schemas/AgentState"
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Name"
          }
        },
        "required": [
          "state"
        ],
        "title": "PendingAction",
        "type": "object"
      },
      "Resize": {
        "properties": {
          "cols": {
            "maximum": 500.0,
            "minimum": 20.0,
            "title": "Cols",
            "type": "integer"
          },
          "rows": {
            "maximum": 300.0,
            "minimum": 5.0,
            "title": "Rows",
            "type": "integer"
          }
        },
        "required": [
          "cols",
          "rows"
        ],
        "title": "Resize",
        "type": "object"
      },
      "RuntimeInfo": {
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "binary": {
            "title": "Binary",
            "type": "string"
          },
          "has_hooks": {
            "title": "Has Hooks",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "binary",
          "available",
          "has_hooks"
        ],
        "title": "RuntimeInfo",
        "type": "object"
      },
      "Screen": {
        "properties": {
          "ansi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "screen with colors and scrollback, when requested",
            "title": "Ansi"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "text": {
            "description": "current screen, plain text",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "text",
          "ansi"
        ],
        "title": "Screen",
        "type": "object"
      },
      "ScreenFrame": {
        "properties": {
          "ansi": {
            "title": "Ansi",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "type": {
            "const": "screen",
            "default": "screen",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "ansi"
        ],
        "title": "ScreenFrame",
        "type": "object"
      },
      "SendInput": {
        "description": "Either literal `text` (optionally followed by Enter) or one tmux `key` name.",
        "properties": {
          "enter": {
            "default": false,
            "title": "Enter",
            "type": "boolean"
          },
          "key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Key"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 20000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "title": "SendInput",
        "type": "object"
      },
      "Session": {
        "properties": {
          "auto_approve": {
            "title": "Auto Approve",
            "type": "boolean"
          },
          "can_auto_approve": {
            "title": "Can Auto Approve",
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "cwd": {
            "title": "Cwd",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Message"
          },
          "matched_rule": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched Rule"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "needs_attention": {
            "title": "Needs Attention",
            "type": "boolean"
          },
          "pending": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingAction"
              },
              {
                "type": "null"
              }
            ]
          },
          "runtime": {
            "title": "Runtime",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/SessionSource"
          },
          "state": {
            "$ref": "#/components/schemas/AgentState"
          },
          "state_source": {
            "$ref": "#/components/schemas/StateSource"
          },
          "tmux_pane": {
            "description": "pane id, e.g. %12, for attaching to the exact pane",
            "title": "Tmux Pane",
            "type": "string"
          },
          "tmux_session": {
            "title": "Tmux Session",
            "type": "string"
          },
          "tmux_socket": {
            "description": "tmux server: \"default\" or a -L socket name",
            "title": "Tmux Socket",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "runtime",
          "cwd",
          "source",
          "tmux_socket",
          "tmux_session",
          "tmux_pane",
          "state",
          "state_source",
          "matched_rule",
          "needs_attention",
          "pending",
          "last_message",
          "auto_approve",
          "can_auto_approve",
          "created_at",
          "updated_at"
        ],
        "title": "Session",
        "type": "object"
      },
      "SessionSource": {
        "enum": [
          "launched",
          "adopted"
        ],
        "title": "SessionSource",
        "type": "string"
      },
      "SessionsFrame": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/Session"
            },
            "title": "Sessions",
            "type": "array"
          },
          "type": {
            "const": "sessions",
            "default": "sessions",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "sessions"
        ],
        "title": "SessionsFrame",
        "type": "object"
      },
      "StateSource": {
        "enum": [
          "hook",
          "screen",
          "default"
        ],
        "title": "StateSource",
        "type": "string"
      },
      "StreamSchema": {
        "description": "Documents the WebSocket message shapes so they reach the generated client types.",
        "properties": {
          "client": {
            "$ref": "#/components/schemas/StreamSubscribe"
          },
          "server": {
            "discriminator": {
              "mapping": {
                "error": "#/components/schemas/ErrorFrame",
                "screen": "#/components/schemas/ScreenFrame",
                "sessions": "#/components/schemas/SessionsFrame"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/SessionsFrame"
              },
              {
                "$ref": "#/components/schemas/ScreenFrame"
              },
              {
                "$ref": "#/components/schemas/ErrorFrame"
              }
            ],
            "title": "Server"
          }
        },
        "required": [
          "client",
          "server"
        ],
        "title": "StreamSchema",
        "type": "object"
      },
      "StreamSubscribe": {
        "properties": {
          "history": {
            "default": 200,
            "maximum": 5000.0,
            "minimum": 0.0,
            "title": "History",
            "type": "integer"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "topic": {
            "enum": [
              "sessions",
              "screen"
            ],
            "title": "Topic",
            "type": "string"
          },
          "type": {
            "enum": [
              "subscribe",
              "unsubscribe"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "topic"
        ],
        "title": "StreamSubscribe",
        "type": "object"
      },
      "Subscribe": {
        "properties": {
          "client_ref": {
            "description": "opaque; echoed in every push (the app's daemon id)",
            "maxLength": 100,
            "title": "Client Ref",
            "type": "string"
          },
          "endpoint": {
            "pattern": "^https://",
            "title": "Endpoint",
            "type": "string"
          },
          "keys": {
            "$ref": "#/components/schemas/SubscriptionKeys"
          },
          "muted": {
            "description": "session ids that never notify",
            "items": {
              "type": "string"
            },
            "title": "Muted",
            "type": "array"
          },
          "states": {
            "items": {
              "$ref": "#/components/schemas/AgentState"
            },
            "title": "States",
            "type": "array"
          }
        },
        "required": [
          "endpoint",
          "keys",
          "client_ref"
        ],
        "title": "Subscribe",
        "type": "object"
      },
      "Subscription": {
        "properties": {
          "client_ref": {
            "title": "Client Ref",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "muted": {
            "items": {
              "type": "string"
            },
            "title": "Muted",
            "type": "array"
          },
          "states": {
            "items": {
              "$ref": "#/components/schemas/AgentState"
            },
            "title": "States",
            "type": "array"
          }
        },
        "required": [
          "id",
          "client_ref",
          "states",
          "muted"
        ],
        "title": "Subscription",
        "type": "object"
      },
      "SubscriptionKeys": {
        "properties": {
          "auth": {
            "title": "Auth",
            "type": "string"
          },
          "p256dh": {
            "title": "P256Dh",
            "type": "string"
          }
        },
        "required": [
          "p256dh",
          "auth"
        ],
        "title": "SubscriptionKeys",
        "type": "object"
      },
      "UpdateSession": {
        "properties": {
          "auto_approve": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auto Approve"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "UpdateSession",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VapidKey": {
        "properties": {
          "public_key": {
            "title": "Public Key",
            "type": "string"
          }
        },
        "required": [
          "public_key"
        ],
        "title": "VapidKey",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "muxtower",
    "version": "0.1.0.dev0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/devices": {
      "get": {
        "operationId": "list_devices_v1_devices_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Device"
                  },
                  "title": "Response List Devices V1 Devices Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Devices",
        "tags": [
          "devices"
        ]
      }
    },
    "/v1/devices/{name}": {
      "delete": {
        "operationId": "revoke_device_v1_devices__name__delete",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke Device",
        "tags": [
          "devices"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "description": "Lets a client check that its token works and learn the daemon's display name.",
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/pair/claim": {
      "post": {
        "description": "Public: redeems a one-time code for this device's own token.",
        "operationId": "claim_pair_code_v1_pair_claim_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Claim Pair Code",
        "tags": [
          "devices"
        ]
      }
    },
    "/v1/pair/codes": {
      "post": {
        "description": "A paired device (or the CLI) asks for a one-time code to hand to a new device.",
        "operationId": "create_pair_code_v1_pair_codes_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairCode"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Pair Code",
        "tags": [
          "devices"
        ]
      }
    },
    "/v1/push/key": {
      "get": {
        "operationId": "vapid_key_v1_push_key_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VapidKey"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Vapid Key",
        "tags": [
          "push"
        ]
      }
    },
    "/v1/push/subscriptions": {
      "post": {
